[Unit]
Description=lnm-bot: read-only local dashboard
After=network-online.target lnmbot.service
Wants=network-online.target

[Service]
Type=simple
User=lnmbot-dashboard
Group=lnmbot-dashboard
SupplementaryGroups=lnmbot-db
WorkingDirectory=@DASHBOARD_RELEASE_DIR@
EnvironmentFile=/etc/lnmbot-dashboard/dashboard.env
Environment=HOME=/nonexistent
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@DASHBOARD_RELEASE_DIR@/.venv/bin/python @DASHBOARD_RELEASE_DIR@/scripts/run_dashboard.py --db /var/lib/lnmbot/lnmarkets.sqlite --host 0.0.0.0 --port 8082
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lnmbot-dashboard

NoNewPrivileges=true
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=@DASHBOARD_RELEASE_DIR@
ReadOnlyPaths=/var/lib/lnmbot
InaccessiblePaths=-/etc/lnmbot
InaccessiblePaths=-/etc/lnd
InaccessiblePaths=-/etc/bitcoin
InaccessiblePaths=-/etc/btcpay
InaccessiblePaths=-/etc/nbxplorer
InaccessiblePaths=-/etc/comstac
InaccessiblePaths=-/var/lib/lnd
InaccessiblePaths=-/var/lib/lndg
InaccessiblePaths=-/var/lib/bitcoin
InaccessiblePaths=-/var/lib/btcpayserver
InaccessiblePaths=-/var/lib/nbxplorer
InaccessiblePaths=-/var/lib/vaultwarden
InaccessiblePaths=-/var/lib/transmission/config
InaccessiblePaths=-/var/lib/comstac
InaccessiblePaths=-/data/bitcoin
InaccessiblePaths=-/data/electrs
InaccessiblePaths=-/data/security-backups
MemoryMax=128M

[Install]
WantedBy=multi-user.target
